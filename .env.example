# Local development only. Compose reads .env; Go uses process environment variables.
MYSQL_PASSWORD=replace-with-local-dev-password
MYSQL_ROOT_PASSWORD=replace-with-local-root-password
MYSQL_PORT=13306
REDIS_PORT=16379
HTTP_ADDR=127.0.0.1:8080
APP_ORIGIN=http://127.0.0.1:5173
# Base64-encoded secret of at least 32 bytes; it derives the CSRF binding and the key that encrypts
# stored SMTP credentials. Generate with: openssl rand -base64 32
# Rotating it invalidates existing CSRF tokens and makes stored SMTP passwords unreadable.
APP_SECRET=replace-with-base64-32-byte-secret
# Set to true only when a reverse proxy that overwrites X-Forwarded-For sits in front of the API.
# Leaving it false makes the per-IP limits count the proxy itself as one client.
TRUST_PROXY=false
# Use mysql.Config escaping if credentials contain DSN-special characters.
MYSQL_DSN=opentalk:replace-with-local-dev-password@tcp(127.0.0.1:13306)/opentalk?parseTime=true&loc=UTC&charset=utf8mb4&time_zone=%27%2B00%3A00%27
REDIS_ADDR=127.0.0.1:16379
REDIS_PASSWORD=
