[Unit]
Description=OpenTalk worker（通知邮件投递：取 outbox、合并、限速、发送前复查可见性与订阅）
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
Type=simple
User=opentalk
Group=opentalk
WorkingDirectory=/srv/opentalk/current
EnvironmentFile=/etc/opentalk/api.env
# 常驻循环：它不在 API 进程里，API 只把事件写进 outbox，所以这个进程必须单独跑。
ExecStart=/srv/opentalk/current/bin/worker -interval 30s
Restart=on-failure
RestartSec=5

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/opentalk/data
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
