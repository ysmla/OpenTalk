# OpenTalk 生产环境变量模板（放到 /etc/opentalk/api.env，chmod 600，owner opentalk）
#
# 这个文件同时给 api、worker、admin、migrate 四个二进制使用：它们读的是同一组环境变量，
# 没有配置文件。Go 进程不会自己去读仓库根目录的 .env。
#
# 填完之后用 systemd 的 EnvironmentFile 加载（见 deploy/systemd/*.service）。

# ---- 监听地址 ----------------------------------------------------------------
# 只绑内网：TLS 与静态文件由 nginx 负责，API 不直接暴露。
HTTP_ADDR=127.0.0.1:8080

# ---- 站点地址 ----------------------------------------------------------------
# 必须是外部可访问的 https 地址，且**与浏览器地址完全一致**（scheme、host、端口）。
# 它同时是：写请求的 Origin 校验依据、邮件里链接的前缀、会话 Cookie 是否加 Secure 的依据。
APP_ORIGIN=https://opentalk.example.com

# ---- 数据库 ------------------------------------------------------------------
# 密码含特殊字符时按 mysql.Config 的 DSN 规则转义。
MYSQL_DSN=opentalk:替换为数据库密码@tcp(127.0.0.1:3306)/opentalk?parseTime=true&loc=UTC&charset=utf8mb4&time_zone=%27%2B00%3A00%27

# ---- Redis -------------------------------------------------------------------
REDIS_ADDR=127.0.0.1:6379
# 生产必须设密码并只监听内网；开发镜像不配认证是为了方便。
REDIS_PASSWORD=替换为Redis密码

# ---- 应用密钥 ----------------------------------------------------------------
# 生成：openssl rand -base64 32
# 它派生出四把子密钥：CSRF 绑定、验证码摘要、站点设置里 SMTP 密码的加密、邮件退订令牌。
# **上线前定好，之后不要再改**：换掉会让全部会话失效，并且解不开已保存的 SMTP 密码。
APP_SECRET=替换为openssl生成的base64

# ---- 反向代理 ----------------------------------------------------------------
# 只有 nginx（或其它代理）确实覆盖 X-Forwarded-For 时才设为 true。
# 直接暴露给客户端时开它，等于让客户端自己声明 IP，按 IP 的限流会退化成全站共享配额。
TRUST_PROXY=true

# ---- 图片存储 ----------------------------------------------------------------
# 必须是进程可写、且在版本库之外；要纳入备份（这里放的是用户上传的原图）。
MEDIA_ROOT=/srv/opentalk/data/media
